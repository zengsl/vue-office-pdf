{
  "name": "vue-pdf-viewer",
  "version": "0.0.1",
  "description": "A pdfjs Vue 3 component library built with Vite.",
  "type": "module",
  "types": "./dist/types",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "files": [
    "dist/index.cjs.js",
    "dist/index.es.js",
    "dist/style.css",
    "dist/pdfjs/*",
    "dist/types/*"
  ],
  "keywords": [
    "vue",
    "vuejs",
    "vite",
    "pdfjs",
    "pdf",
    "viewer"
  ],
  "author": "zzz",
  "homepage": "https://github.com/zengsl/vue3-pdf-app#readme",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "test:unit": "vitest --environment jsdom",
    "build-publish": "build-dts build-only",
    "build-only": "vite build",
    "build-dts": "vue-tsc -p tsconfig.app.json",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "preview": "vite preview --port 4173",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@mdi/font": "^7.0.96",
    "@rushstack/eslint-patch": "^1.1.4",
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "18",
    "@types/pdfjs-dist": "^2.10.378",
    "@vitejs/plugin-vue": "^3.0.3",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/test-utils": "^2.0.2",
    "@vue/tsconfig": "^0.6.0",
    "core-js": "^3.8.3",
    "element-plus": "2.7.8",
    "eslint": "^9.10.0",
    "eslint-plugin-case-police": "^1.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^20.0.0",
    "npm-run-all": "^4.1.5",
    "sass": "1.77.5",
    "typescript": "^5.8.2",
    "vite": "5.3.2",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-dts": "^4.3.5",
    "vitest": "^0.23.0",
    "vue-router": "^4.1.5",
    "vue-tsc": "^0.40.7"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": "^18"
  }
}
