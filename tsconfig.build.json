{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/**/*.ts"],
  "exclude": ["src/**/__tests__/*","src/components/about-view.vue","src/views","src/router","src/main.ts"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "declaration": true, // 生成 .d.ts 文件
    "declarationDir": "./dist/types/", // 声明文件输出目录
    "outDir": "./dist/", // 编译输出目录
    "rootDir": "./src", // 源代码目录
    "emitDeclarationOnly": true, // 仅生成声明文件，不编译 JS,
  }
}
